# netra hub configuration. Copy to .env and fill in the three empty values —
# two secrets and the hostname. Nothing here ships a working-looking default:
# an empty value fails loudly, a fake one fails silently.
#
#   cp .env.example .env
#
# .env is gitignored. compose.yaml reads it automatically.

# Postgres password for the `netra` role. Used by both services — the hub
# interpolates it into NETRA_DB_DSN and timescaledb initialises with it.
#
# This is baked into the data directory on first start. Changing it later means
# ALTER ROLE inside the running container, not just editing this file.
#
# HEX, not base64. This value is interpolated RAW into a URL — see
# NETRA_DB_DSN in compose.yaml — and base64's alphabet includes `/`, which ends
# the authority section: `postgres://netra:ab/cd@timescaledb:5432/...` fails to
# parse with "invalid port". A 32-byte base64 password carries at least one `/`
# about half the time, so the hub crash-loops against a perfectly healthy
# database on roughly every other fresh install. Percent-encoding is not a fix
# either: the same value is timescaledb's literal role password, so it has to
# be URL-safe as written.
#
#   openssl rand -hex 32
POSTGRES_PASSWORD=

# Single shared token for the read and admin API, and the login for the host
# management UI. The hub refuses to start without it rather than exposing an
# unauthenticated admin API.
#
# Traefik fronts the whole hub on NETRA_HOSTNAME, so this token is the ONLY
# thing between the internet and an API that mints agent tokens and deletes
# hosts. There is no second line of defence behind it. Generate it, do not
# invent it, and rotate it if it ever lands in a shell history or a paste.
#
# The UI is at https://<NETRA_HOSTNAME>/ — paste this value into the login
# field. curl and scripts send it as `Authorization: Bearer <token>` instead.
#
# Changing this value logs every open browser session out: the session cookie
# is signed with a key derived from it.
#
# Per-user roles arrive with OIDC in phase 2; until then this one token grants
# everything, including minting agent tokens and deleting hosts.
#
#   openssl rand -hex 32
NETRA_ADMIN_TOKEN=

# REQUIRED. Hostname Traefik routes to. The certificate pre-loaded in Traefik's
# static configuration has to cover this name — there is no ACME resolver on the
# router, so a mismatch is a TLS error, not an automatic reissue.
#
# This is the address the UI, the API and the AGENTS all use: compose derives
# NETRA_HUB_URL from it, and the hub UI renders that into the setup-agent.sh
# command you paste on each monitored host.
#
# Deliberately empty, like the two secrets above. compose.yaml marks it `:?`, so
# `docker compose up` refuses with a message rather than starting a hub whose
# ingest route matches a domain you do not own — which used to happen silently,
# because this file shipped a plausible-looking example value.
NETRA_HOSTNAME=

# debug | info | warn | error
NETRA_LOG_LEVEL=info

# Retention is NOT configurable in phase 1. The spec (§12) lists
# NETRA_RETENTION_RAW / _5M / _1H, but the tiers are fixed in the migration —
# 7 days raw, 30 days at 5m, 90 days at 1h, in
# internal/hub/store/migrations/0001_init.sql. Setting those variables here
# would do nothing, so they are deliberately absent rather than present and
# ignored. Changing a tier today means editing the migration and re-applying
# the retention policy by hand.
