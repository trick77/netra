FROM golang:1.26-alpine AS build

# Both are mandatory for a release image. The Makefile derives COMMIT from
# `git rev-parse`, but the build context carries no .git (see .dockerignore)
# and the builder has no git binary, so an unpassed COMMIT would stamp
# "unknown" into a shipped binary. The defaults keep a bare `docker build`
# working and match internal/buildinfo's own fallbacks.
ARG VERSION=dev
ARG COMMIT=unknown

WORKDIR /src

# Manifests first so the module download layer survives any source edit.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

# The cache mounts are repeated here on purpose: mount contents never land in
# the image layer, so without /go/pkg/mod the modules fetched above are gone.
# -ldflags mirrors the Makefile exactly; drift here means the CI version-
# stamping guard passes while the image reports something else.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath \
      -ldflags "-s -w -X github.com/trick77/netra/internal/buildinfo.version=$VERSION -X github.com/trick77/netra/internal/buildinfo.commit=$COMMIT" \
      -o /out/netra-agent ./cmd/netra-agent

# Digest-pinned so the runtime contents are reproducible across rebuilds; the
# tag alone moves. This is a multi-arch index, so amd64 and arm64 both resolve.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# ARG does not cross a FROM boundary, so these are re-declared purely to feed
# the labels below.
ARG VERSION=dev
ARG COMMIT=unknown

LABEL org.opencontainers.image.source="https://github.com/trick77/netra" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$COMMIT"

# smartmontools is deliberately unversioned. The base digest above is what
# pins the resolved version, and Alpine keeps only the current revision in the
# index — an `=7.5-r0` constraint would break the build the day that revision
# is rolled out. At the pinned digest this resolves to smartmontools-7.5-r0
# (smartctl 7.5 2025-04-30 r5714), so bumping the base surfaces the version
# change in the diff of this comment.
# ca-certificates is required: the agent POSTs telemetry to the hub over HTTPS.
#
# There is deliberately nothing here for the systemd collector, and adding
# something would not work: systemd is not packaged for Alpine at any version,
# and a bind-mounted systemctl from the host is glibc-linked and will not
# execute against musl. The collector speaks D-Bus directly instead, so all it
# needs is the system bus socket mounted in -- no binary at all. It reported a
# "systemd: unavailable" capability on every host for exactly as long as it
# shelled out to systemctl.
RUN apk add --no-cache ca-certificates smartmontools

COPY --from=build /out/netra-agent /usr/local/bin/netra-agent

# Runs as root by design. smartctl issues ATA/NVMe passthrough ioctls against
# /dev/sd*, /dev/nvme*, which need SYS_RAWIO plus the device to be mapped in;
# a dropped-privilege user gets EACCES and every SMART reading disappears.
# No EXPOSE: the agent runs with network_mode: host and listens on nothing.
ENTRYPOINT ["/usr/local/bin/netra-agent"]
