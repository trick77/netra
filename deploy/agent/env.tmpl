# netra agent configuration — RENDERED BY setup-agent.sh.
#
# The annotated reference for every variable, including the ones deliberately
# absent here, is .env.example next to this file.
#
# ---------------------------------------------------------------------------
# HOW THIS TEMPLATE IS SUBSTITUTED
# ---------------------------------------------------------------------------
# Inline `__NAME__` tokens, replaced with awk gsub-style rebuilding rather than
# `sed s///`: a token value containing `/` or `&` would break a sed expression,
# and a hub URL contains slashes by definition.
#
# Values are written UNQUOTED. Compose's env_file parser takes the remainder of
# the line literally, so adding quotes would make the quotes part of the value.
# The setup script validates instead: a value containing a newline or a carriage
# return is rejected outright, because there is no escaping that makes it work.
#
# There is deliberately NO AGENT_INTERVAL. The scrape interval is a fixed 60s
# constant (config.ScrapeInterval); see .env.example for why it is not a knob.

# --- Required ----------------------------------------------------------------

AGENT_HUB_URL=__HUB_URL__

# Minted by the hub, never invented by the setup script. The agent refuses to start
# while this is empty.
AGENT_TOKEN=__TOKEN__

# --- Host identity: operator-stated facts ------------------------------------
#
# The setup script does not guess these, it ASKS. Anything left blank can be
# filled in here; restart the agent afterwards.
AGENT_LOCATION=__LOCATION__
AGENT_PROVIDER=__PROVIDER__
# Not asked for: a datacenter code most self-hosters do not have. A prompt
# nobody can answer teaches people to hit Enter through the rest of them.
AGENT_FACILITY=
AGENT_HOST_TYPE=__HOST_TYPE__

# --- Buffering, logging, roots -----------------------------------------------

AGENT_BUFFER_WINDOW=1h
AGENT_LOG_LEVEL=info
AGENT_PROC_ROOT=/proc
AGENT_SYSFS_ROOT=/sys

# What each measured filesystem is called ON THIS HOST: `label=mountpoint`,
# comma separated. RENDERED FROM THE SAME LIST AS THE BIND MOUNTS — do not edit
# it by hand, re-run the setup script.
#
# The agent measures a filesystem through an empty marker file bind-mounted to
# /netra/fs/<label> inside its container. That target is where it must call
# statfs, and it is also a path that exists nowhere on this host. This line is
# what lets the agent report `ark` at `/mnt/ark` instead of the inside of its
# own container. A `,` or `=` in a mount point is percent-encoded.
AGENT_FS_MOUNTS=__FS_MOUNTS__

# Whether this container was rendered with `pid: host`.
#
# Always 1: the template renders `pid: host` unconditionally, so the script
# knows the answer without asking. It stays an env var rather than becoming an
# assumption because the hand-written compose.yaml.example path can still omit
# the namespace, and a collector that guesses has a case it gets wrong.
AGENT_PID_HOST=1

# Where the logged-in session count is read from. Only meaningful when the
# matching bind mount exists; the collector reports the file as unavailable
# and leaves the metric NULL otherwise.
AGENT_UTMP_PATH=/var/run/utmp

# --- Sensors -----------------------------------------------------------------
#
# Empty means automatic selection, which prefers known CPU chips (coretemp,
# k10temp, zenpower, then thermal zones) over hottest-wins. The setup script
# writes a value here ONLY when --primary-sensor was passed: freezing a
# setup-time guess into .env would outlive the hardware change that invalidates
# it, so a tie between equally-ranked chips is reported and left to the agent
# rather than resolved by a prompt.
AGENT_PRIMARY_SENSOR=__PRIMARY_SENSOR__
