# netra agent — runs on every monitored Linux host and POSTs samples to the hub.
#
# This file is the hand-written reference. `setup-agent.sh` detects what a host
# actually has and renders an equivalent file for you; copy this one only if you
# are deliberately skipping the setup script and want to decide each mount yourself.
#
#   cp compose.yaml.example compose.yaml
#   cp env.tmpl .env && $EDITOR .env          # hub URL and token; replace every __PLACEHOLDER__
#   true >> /.netra                           # see "Filesystems" below
#   docker compose up -d
#
# WHAT IS IMPLEMENTED TODAY (phase 1): all twenty-two collectors.
#
# Needing nothing but /proc and /sys — no mount, no capability, no device:
#   CPU, per-core CPU, memory, load, kernelstat, vmstat, limits, netstat,
#   procs, users, disk I/O (/proc/diskstats), sensors (/sys/class/hwmon),
#   mdraid (sysfs).
#
# Needing network_mode: host, or they see the container's namespace instead of
# the host's:
#   network (/proc/net/dev), addresses.
#
# Needing a mount, each called out where it is configured below:
#   containers (cgroup v2 + the Docker socket for names only), filesystems,
#   systemd, packages.
#
# Needing a privilege the operator grants explicitly:
#   SMART (device access), processes (pid: host).
#
# A collector that cannot run reports WHY as a capability and is skipped; it
# never prevents the agent from starting. So a host that grants none of the
# optional access below still delivers every collector in the first group.
#
# The two long-standing exceptions are called out where they are configured
# below —
#
#   * procs reports a total process count only with `pid: host`. Without it the
#     agent sees its own PID namespace, and reports the metric as unavailable
#     rather than reporting the two processes it can see.
#   * users needs the /var/run/utmp bind. Without it, or on a system with no
#     utmp writer at all (Alpine and other busybox systems), the session count
#     is reported as unavailable.
#
# Both leave their metric NULL rather than 0 when unavailable, and record why
# in the host's capabilities.
#
# Every OTHER mount, capability and device below now HAS a collector consuming
# it. Granting one turns its collector on; declining leaves that collector
# reporting an unavailable capability and every other collector unaffected.
# This paragraph used to say these were inert -- they were, until Stage 1C
# landed the collectors, and leaving it would have been a lie about what works.
#
# Every OPTIONAL mount, device and capability below ships COMMENTED
# OUT. Uncommenting one whose source does not exist is not a no-op: a long-form
# bind does not create a missing source, and a `devices:` entry for a node this
# host lacks stops the container from starting at all. Uncomment what this host
# actually has.
#
# The mounts left ACTIVE are the ones a Docker host has by definition —
# /var/run/docker.sock, /proc/1/mountinfo — plus /.netra, which the quickstart
# above creates, and /etc/machine-id, which every systemd host has. That last
# one is the single conditional mount that is active by default, because
# without it the hub cannot tell a copied token from a legitimate one and
# nothing says so at runtime; see the note on it below, which names the swap
# for hosts that keep their id elsewhere.
#
# The agent is STATELESS. There is no volume for state anywhere in this file and
# there never will be: the buffer is an in-memory ring (§6.5), deliberately not
# durable across a restart, so there is no data directory to back up or corrupt.
services:
  netra-agent:
    image: ghcr.io/trick77/netra-agent:latest
    restart: unless-stopped

    # Required, not a convenience. The network collector reads /proc/net/dev and
    # the address collector talks netlink; inside Docker's own namespace both see
    # the container's veth pair instead of the host's interfaces, so the metrics
    # would be real numbers about the wrong machine. Because of this the agent
    # must NOT also declare `networks:` — Compose rejects that combination.
    #
    # It publishes no port and listens on nothing; host networking here is read
    # access to the host's network state, not an exposed service.
    network_mode: host

    env_file:
      - .env

    # The agent never gains privileges through a setuid binary. smartctl is
    # invoked with the capabilities granted below and needs no escalation path.
    security_opt:
      - no-new-privileges:true

    # Every bind is written in LONG FORM on purpose. The `source:target:ro` short
    # form is parsed by splitting on ':', so a host mount point that contains a
    # colon breaks it outright and one that contains a space has to be quoted.
    # setup-agent.sh renders the same long form, so a hand-written file and a
    # generated one stay comparable line for line.
    volumes:
      # --- Filesystems (marker files, §6.4) --------------------------------
      #
      # statfs() reports the filesystem containing the path it is given, so the
      # measured path has to physically live on that filesystem. What is mounted
      # is therefore an EMPTY marker file, never the data: complete disk-usage
      # and inode metrics with zero data exposure. That least-privilege property
      # is exactly why a single `/host` root mount was rejected despite being
      # far more convenient to write.
      #
      # statfs() does not care what KIND of object the path is, only which
      # filesystem it lives on, so a directory at the same path measures exactly
      # the same thing. Releases before this one created directories, and
      # setup-agent.sh leaves an existing one alone rather than churn a working
      # install.
      #
      # Create the markers before the first run (`>>` creates without ever
      # truncating, unlike `>`; `true` rather than `:` because `:` is a special
      # builtin, and a redirection error on one — an existing DIRECTORY at that
      # path, say — exits a non-interactive shell, taking a provisioning script
      # with it):
      #
      #   true >> /.netra
      #   true >> /mnt/ark/.netra
      #
      # The label is the trailing path segment of the TARGET, so /netra/fs/root
      # is labelled `root` and /netra/fs/ark is labelled `ark`. Two markers that
      # land on the same filesystem are deduplicated by st_dev — the agent keeps
      # the first and logs a warning naming both, rather than double-reporting
      # one filesystem under two names.
      #
      # The root filesystem is not a special case in code: it gets its own marker
      # like everything else. If /netra/fs/ is empty the agent logs a startup
      # warning and carries on — a container-only host is legitimate.
      #
      # read_only here documents intent. An empty file has nothing to protect,
      # so it costs nothing to be explicit.
      - type: bind
        source: /.netra
        target: /netra/fs/root
        read_only: true
      # One extra example. Repeat this block per filesystem you want measured —
      # and DELETE it if this host has no second filesystem. A long-form bind
      # does not create a missing source the way the short form does, so a
      # source that is not there is a container startup failure, not a warning.
      # Same rule as the `devices:` list below.
      # - type: bind
      #   source: /mnt/ark/.netra
      #   target: /netra/fs/ark
      #   read_only: true

      # --- Containers -------------------------------------------------------
      #
      # Read-only, and used for far less than it looks like. Container CPU and
      # memory are read from cgroup v2 files directly; the socket supplies only
      # the container list, names, labels, health and image, and only when that
      # list changes. Calling the Docker stats API per container per scrape is
      # the single most expensive thing a naive agent does, and this avoids it.
      #
      # Without this mount: no container inventory and no container metrics.
      #
      # `read_only: true` here restricts the INODE, not the API. Anything that
      # can talk to the Docker socket at all can start a privileged container,
      # which is root on the host — strictly more powerful than the SYS_ADMIN
      # this file is careful to gate below. It is mounted by default because the
      # container collectors are the point of the agent, but grant it knowing
      # that, not because it says read-only.
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
        read_only: true

      # --- Host fingerprint -------------------------------------------------
      #
      # The agent hashes this into the metadata fingerprint, which is how the
      # hub notices a token that has been copied to a second machine. The image
      # is Alpine and has NO /etc/machine-id of its own, so without this mount
      # the fingerprint is empty on every containerised agent and the check can
      # never fire.
      #
      # ACTIVE by default, unlike every other conditional mount in this file:
      # an agent that silently cannot be fingerprinted is a security control
      # that fails open with nothing to notice, whereas a host without
      # /etc/machine-id fails LOUDLY here — the container will not start,
      # because a long-form bind does not create a missing source.
      #
      # If that happens, this host keeps its id at the pre-systemd location.
      # Swap the two blocks: the source changes, the target stays
      # /etc/machine-id either way, because that is where the agent looks.
      - type: bind
        source: /etc/machine-id
        target: /etc/machine-id
        read_only: true
      # Hosts predating systemd's location: comment out the block above and
      # use this instead.
      # - type: bind
      #   source: /var/lib/dbus/machine-id
      #   target: /etc/machine-id
      #   read_only: true

      # --- OPTIONAL: systemd units ------------------------------------------
      #
      # Enables the systemd collector, which calls
      # org.freedesktop.systemd1.Manager.ListUnits on the system bus. This
      # socket is the ONLY thing it needs: the agent speaks D-Bus itself and
      # does not run systemctl, which is absent from the image (netra-agent
      # ships on Alpine, and systemd is not packaged for musl).
      #
      # The agent must be able to read and write the socket, which is why it
      # runs as root -- the bus rejects an unprivileged peer that has not been
      # granted a policy for it.
      #
      # On a host whose systemd predates the /run/dbus location, use
      # /var/run/dbus/system_bus_socket instead.
      #
      # Without it: the collector reports a "systemd: unavailable" capability
      # rather than an error, so the host still reports everything else. There
      # is no unit inventory, no failed-service alerting, and
      # services_total / services_failed stay unset on every host sample.
      #
      # Only unit state CHANGES are stored, plus that summary. The first
      # scrape after an agent start emits one baseline event per service, so a
      # unit that was already failed when the agent arrived is visible rather
      # than waiting for its next transition.
      # - type: bind
      #   source: /run/dbus/system_bus_socket
      #   target: /run/dbus/system_bus_socket
      #   read_only: true

      # --- OPTIONAL: package inventory --------------------------------------
      #
      # Enables the packages collector, which builds the "what changed on this
      # host just before it started misbehaving" timeline. Mount the directory
      # for the package manager this host actually uses — ONE of these, not both:
      #
      #   Debian/Ubuntu — /var/lib/dpkg   (the collector parses .../status)
      #   Alpine        — /lib/apk/db     (the collector parses .../installed)
      #
      # rpm is NOT supported: its Berkeley DB/SQLite store needs librpm or the
      # rpm binary. On a RHEL-family host the collector reports an unsupported-
      # format capability instead of silently producing nothing, so mounting
      # anything here on such a host gains you nothing.
      #
      # Parsed only when the database mtime changes, with a daily floor, so this
      # mount costs essentially nothing at steady state.
      # - type: bind
      #   source: /var/lib/dpkg
      #   target: /var/lib/dpkg
      #   read_only: true
      # Alpine hosts: comment out the dpkg block above and use this instead.
      # - type: bind
      #   source: /lib/apk/db
      #   target: /lib/apk/db
      #   read_only: true

      # --- OPTIONAL: logged-in users ----------------------------------------
      #
      # Enables the users collector, which reports ONE NUMBER: how many
      # interactive sessions are logged in. This one IS implemented today.
      #
      # Nothing about a session is transmitted — not the username, not the tty,
      # not the remote host. The parser reads a single 2-byte field per record
      # (ut_type) and counts the ones marked USER_PROCESS; the usernames and
      # hostnames in the file are never even decoded.
      #
      # Absent, the count is reported as unavailable and left NULL. That is
      # also the normal outcome on Alpine and other busybox-based systems,
      # which ship no utmp writer at all — there the file is missing or empty
      # no matter what you mount.
      # - type: bind
      #   source: /var/run/utmp
      #   target: /var/run/utmp
      #   read_only: true

      # --- OPTIONAL: filesystem discovery (awareness only) ------------------
      #
      # Exposes the host mount table and nothing else. This NEVER feeds metrics:
      # measurement is exclusively marker-file statfs, above. All it does is let
      # the agent log one line per unmonitored filesystem at startup, and again
      # only when the set changes:
      #
      #   filesystem /mnt/backup (8.0T, ext4) is not monitored — bind-mount a
      #   marker file to /netra/fs/<name> to enable
      #
      # Absent, that check is skipped silently and nothing else changes.
      #
      # UNVERIFIED (spec §14 item 1): whether bind-mounting a procfs FILE yields
      # live reads or a one-time snapshot has not been confirmed. If it turns out
      # to be a snapshot this mount is dropped entirely and the markers remain
      # the only mechanism. Note this concerns a PROCFS file specifically; a
      # marker on a real filesystem is measured with statfs(), which reads the
      # superblock and never the file. Treat it as provisional.
      - type: bind
        source: /proc/1/mountinfo
        target: /host/mountinfo
        read_only: true

    # --- Sensors, mdraid: NOTHING TO ADD -------------------------------------
    #
    # Do not add a /sys mount for these. Docker already mounts /sys read-only in
    # every container, so the sensors collector (/sys/class/hwmon) and the mdraid
    # collector (sysfs) work with no mount, no capability and no device. A
    # hand-added /sys bind is at best redundant and at worst mounts it writable.
    #
    # This is also why NVMe temperatures are free: they come from hwmon, not from
    # smartctl. See the SYS_ADMIN note below.

    # --- SMART ---------------------------------------------------------------
    #
    # smartctl ships inside the image at a pinned version, so behaviour does not
    # vary with whatever the host distro packaged. It drives disks through kernel
    # ioctls, which is what these capabilities are for.
    #
    # SYS_RAWIO covers SATA/SAS drives (ATA passthrough) and is the ordinary
    # case. Without it every SMART reading disappears and the agent reports SMART
    # as an unavailable capability rather than showing an empty panel.
    # cap_add:
    #   - SYS_RAWIO
      # SYS_ADMIN — READ THIS BEFORE UNCOMMENTING.
      #
      # Required ONLY when this host has NVMe drives, because NVMe admin
      # passthrough needs it. It is root-adjacent — close enough to full root on
      # the host that it must never be pasted in unconditionally "just in case".
      #
      # What declining actually costs you: NVMe SMART health status and wear
      # indicators. It does NOT cost you NVMe temperature. NVMe temperatures come
      # from /sys/class/hwmon via the sensors collector, which needs no
      # capability, no device entry and no smartctl at all. On a host with only
      # NVMe drives, leaving this commented out still gives you drive temps.
      # - SYS_ADMIN

    # The physical controllers/whole devices, never partitions: /dev/sda, not
    # /dev/sda1; /dev/nvme0 (the controller), not /dev/nvme0n1 (the namespace).
    # smartctl talks to the device, and a partition node cannot answer.
    #
    # Edit this list to match the host — `lsblk -d` lists the whole devices.
    # A device listed here that does not exist prevents the container starting,
    # so remove the ones this host lacks.
    # devices:
    #   - /dev/sda
    #   - /dev/nvme0

    # --- Processes (opt-in) --------------------------------------------------
    #
    # pid: host is what makes the processes collector possible: without the
    # host PID namespace the agent sees only itself in /proc.
    #
    # Partly implemented today: with this enabled the agent reports a total
    # process count. Without it that metric is NULL and the host's
    # capabilities say "namespaced" — it is never guessed at. The per-process
    # CPU and memory breakdown is still a later phase.
    #
    # If you uncomment this, also set NETRA_PID_HOST=1 in .env. The agent can
    # only guess otherwise, and every guess has a case it gets wrong; the
    # setup script writes this for you.
    #
    # It is commented out by default and should stay that way unless you want
    # per-process metrics enough to accept the exposure. Sharing the host PID
    # namespace makes EVERY process's /proc entry readable to this container,
    # including cmdline and environ — that is command-line arguments and
    # environment variables of every service on the box, which routinely carry
    # passwords, API keys and DSNs.
    #
    # netra reads NEITHER. Process names come from `comm` (/proc/PID/comm, 15
    # bytes, no arguments), and the agent never opens cmdline or environ at all
    # — enforced by internal/agent/collector/argv_guard_test.go, which fails the
    # build if either name appears in a Go string literal. The collector
    # aggregates CPU and memory by process name and nothing else.
    #
    # So the exposure is the namespace, not the agent: it grants far more than
    # netra uses, and you are trusting the image not to use it.
    # pid: host
