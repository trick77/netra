{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — netra</title>
<style>
:root {
  --bg: #fbfbfa; --surface: #fff; --border: #e3e1dc; --text: #22201c;
  --muted: #6b6862; --accent: #b4531f; --accent-soft: #fdf1e8; --code-bg: #f5f3ef;
  --danger: #a32b2b; --ok: #3f7a4a;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #171614; --surface: #1e1d1a; --border: #33312c; --text: #e8e5df;
    --muted: #9a958c; --accent: #e08c4f; --accent-soft: #2a211a; --code-bg: #232220;
    --danger: #e07a7a; --ok: #6fae7c;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 2.5rem 1.5rem 5rem; background: var(--bg); color: var(--text);
  font: 15px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
}
main { max-width: 52rem; margin: 0 auto; }
h1 { font-size: 1.5rem; margin: 0 0 .3rem; letter-spacing: -.01em; }
h2 { font-size: 1.05rem; margin: 2.5rem 0 .8rem; }
p { margin: .6rem 0; }
.sub { color: var(--muted); margin: 0 0 2rem; }
a { color: var(--accent); }
code, pre {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  background: var(--code-bg); border-radius: 4px;
}
code { padding: .12em .4em; font-size: .87em; }
pre { padding: .9rem 1rem; overflow-x: auto; border: 1px solid var(--border); font-size: .82rem; }
table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
th, td { text-align: left; padding: .55rem .7rem; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .05em; }
form.inline { display: inline; }
input[type=text], input[type=password] {
  font: inherit; padding: .45rem .6rem; border: 1px solid var(--border);
  border-radius: 5px; background: var(--surface); color: var(--text); min-width: 16rem;
}
button, a.button {
  font: inherit; padding: .45rem .9rem; border: 1px solid var(--border);
  border-radius: 5px; background: var(--surface); color: var(--text); cursor: pointer;
}
a.button { display: inline-block; text-decoration: none; }
button.primary, a.button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
button.danger { color: var(--danger); }
.card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 8px; padding: 1.2rem 1.4rem; margin: 1.2rem 0;
}
.error { color: var(--danger); }
.muted { color: var(--muted); }
.warn { border-left: 4px solid var(--accent); padding-left: .9rem; }
</style>
</head>
<body>
<main>
{{template "content" .}}
</main>
</body>
</html>{{end}}
