{{define "layout"}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} — netra</title>
<!-- The SPA's tab icon (ui/icons/icon.svg, rasters via hack/gen-icons.sh). It
     is served from dist/ like the SPA's copy, but off a route outside
     RequireAdmin -- see web.PublicAssetPaths -- because this page is the one an
     unauthenticated browser sees, and the catch-all would answer the request
     with a redirect back to this page.

     PNG first, SVG second, matching ui/index.html: a browser keeps the LAST
     type it understands, so the SVG wins wherever it is supported and Safari
     before 26 -- which ignores an SVG favicon outright -- still gets an icon
     rather than a blank tab. Change one file and change the other. -->
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<style>
/* The palette is the SPA's, direction "Clay" (ui/src/index.css @theme), copied
   rather than imported: this page is served by the Go binary and must render
   before a single byte of the bundle exists. It used to carry a light/dark
   palette of its own, which made the one screen every user meets first the one
   screen that looked like a different product.

   Copied means it can drift. If a token below is changed, change it there too
   -- there are five, and they are the five the SPA states first. */
:root {
  --bg: #131312;
  --surface: #1b1b1a;
  --surface-2: #222221;
  --raised: #2a2a28;
  --border: #2b2b29;
  --border-strong: #3b3b38;
  --ink: #c7c4bb;
  --ink-2: #a3a099;
  --muted: #94918a;
  --accent: #d97757;
  --accent-fill: #b85a30;
  --on-accent: #fff;
  --st-crit: #d03b3b;
  --radius-ui: 8px;
  --radius-sm: 5px;
  /* The app's own faces are hashed Vite assets this page cannot link, so each
     stack is the SPA's with its fallback doing the work: Georgia carries the
     wordmark, the system UI face carries everything else. */
  --font-sans: "Anthropic Sans", system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-serif: "Anthropic Serif", Georgia, "Times New Roman", serif;
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --text-label: 0.875rem;
  --text-micro: 0.75rem;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  /* dvh second: on iOS Safari the URL bar makes 100vh taller than the visible
     area, which pushes the card off-centre until the bar retracts. */
  min-height: 100dvh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  overflow: hidden;
  /* If the cover 404s or is still loading, what shows through is the app's own
     ground, not white. */
  background: var(--bg);
  color: var(--ink);
  font: 15px/1.55 var(--font-sans);
}
.cover {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* 38%, not centre: the racks and their reflection are the left third of the
     art and the corridor runs out to black on the right. Centred, a portrait
     window crops to the empty floor and the screen has nothing in it. */
  object-position: 38% 50%;
}
/* Two washes, both light. The radial seats the card; the linear takes the lit
   racks down a step so they stop competing with the button. Neither is doing
   legibility work -- that is the card's opaque fill -- which is what lets the
   art stay lit rather than being dimmed to hold text it never holds. */
.wash {
  position: fixed;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(42% 54% at 50% 50%, rgba(19,19,18,.72) 0%, rgba(19,19,18,.34) 58%, transparent 100%),
    linear-gradient(90deg, rgba(19,19,18,.5) 0%, rgba(19,19,18,.2) 46%, rgba(19,19,18,.06) 100%);
}
/* z-index, because the wash is painted after the card in source order and
   would otherwise veil the wordmark, the copy and the button. */
.card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 380px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-ui);
  padding: 30px;
  box-shadow: 0 18px 48px rgba(0, 0, 0, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  text-align: center;
}
/* The rail's wordmark (ui/src/index.css .brand), scaled up: same serif, same
   accent. 32px because this one has nothing around it. */
.brand {
  font-family: var(--font-serif);
  font-size: 32px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -0.01em;
  color: var(--accent);
}
.tag {
  margin: 0;
  max-width: 260px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--muted);
}
.error {
  width: 100%;
  text-align: left;
  font-size: var(--text-label);
  color: var(--st-crit);
  background: rgba(208, 59, 59, 0.09);
  border: 1px solid rgba(208, 59, 59, 0.35);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
}
.btn {
  font: inherit;
  font-size: var(--text-label);
  font-weight: 500;
  height: 34px;
  padding: 0 14px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.btn.primary {
  background: var(--accent-fill);
  border-color: var(--accent-fill);
  color: var(--on-accent);
  font-weight: 600;
}
a.btn { text-decoration: none; }
/* The one action on the screen, so it takes the width and a little height. */
.go { width: 100%; height: 38px; }
.ctl {
  font: inherit;
  font-size: var(--text-label);
  height: 34px;
  padding: 0 10px;
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  background: var(--surface-2);
  color: var(--ink);
  width: 100%;
}
/* The token fallback stays closed, and its summary is a quiet line rather than
   a second button: with a provider configured there is exactly one thing to
   press here. Without one the form is rendered open, and this rule never
   applies. */
details {
  width: 100%;
  border-top: 1px solid var(--border);
  padding-top: 16px;
}
summary {
  cursor: pointer;
  font-size: var(--text-label);
  color: var(--ink-2);
  list-style: none;
  text-align: center;
}
summary::-webkit-details-marker { display: none; }
summary:hover { color: var(--accent); }
.tokenform {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 14px;
}
.note {
  margin: 0;
  font-size: var(--text-micro);
  line-height: 1.5;
  color: var(--muted);
  text-align: left;
}
code {
  font-family: var(--font-mono);
  font-size: 0.92em;
  background: var(--raised);
  border-radius: 4px;
  padding: 0.1em 0.35em;
}
/* Every control shows where the keyboard is, matching the SPA's rule. */
a:focus-visible,
button:focus-visible,
input:focus-visible,
summary:focus-visible {
  outline: 2px solid var(--accent-fill);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}
</style>
</head>
<body>
<img class="cover" src="/login-cover.webp" alt="">
<div class="wash"></div>
{{template "content" .}}
</body>
</html>{{end}}
