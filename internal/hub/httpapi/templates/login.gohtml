{{define "content"}}
<h1>netra</h1>

<div class="card">
  {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

  {{if .OIDC}}
  <p class="sub">Sign in to continue.</p>
  <a href="/auth/login" class="primary button">Sign in</a>

  <details>
    <summary class="muted">Use the admin token instead</summary>
  {{else}}
  <p class="sub">Enter the admin token to continue.</p>
  {{end}}

    <form method="post" action="/login">
      <input type="password" name="token" placeholder="admin token"
             {{if not .OIDC}}autofocus{{end}} required>
      <button type="submit" class="primary">Log in</button>
    </form>
    <p class="muted">This is <code>NETRA_ADMIN_TOKEN</code> from the hub's
    environment, not an agent token.</p>

  {{if .OIDC}}
  </details>
  {{end}}
</div>
{{end}}
