{{define "content"}}
<main class="card">
  <div class="brand">netra</div>
  <p class="tag">Fleet monitoring for self-hosted Linux boxes.</p>

  {{if .Error}}<p class="error" role="alert">{{.Error}}</p>{{end}}

  {{if .OIDC}}
  <a href="/auth/login" class="btn primary go">Sign in</a>

  <details>
    <summary>Use the admin token instead</summary>
  {{end}}

    <form method="post" action="/login" class="tokenform">
      <input class="ctl" type="password" name="token" placeholder="Admin token"
             autocomplete="current-password"
             {{if not .OIDC}}autofocus{{end}} required>
      <button type="submit" class="btn{{if not .OIDC}} primary go{{end}}">Log in</button>
      <p class="note">This is <code>BACKEND_ADMIN_TOKEN</code> from the hub's
      environment, not an agent token.</p>
    </form>

  {{if .OIDC}}
  </details>
  {{end}}
</main>
{{end}}
